{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${YOGO_REPO:-$HOME/Yogo}\"/bin/yogo daemon --idle breathe >/dev/null 2>&1; \"${YOGO_REPO:-$HOME/Yogo}\"/bin/yogo-signal claude-code idle",
            "async": true,
            "timeout": 20
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${YOGO_REPO:-$HOME/Yogo}\"/bin/yogo-signal claude-code thinking",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${YOGO_REPO:-$HOME/Yogo}\"/bin/yogo-signal claude-code tool",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${YOGO_REPO:-$HOME/Yogo}\"/bin/yogo-signal claude-code thinking",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${YOGO_REPO:-$HOME/Yogo}\"/bin/yogo-signal claude-code error",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${YOGO_REPO:-$HOME/Yogo}\"/bin/yogo-signal claude-code waiting",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${YOGO_REPO:-$HOME/Yogo}\"/bin/yogo-signal claude-code waiting",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "Elicitation": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${YOGO_REPO:-$HOME/Yogo}\"/bin/yogo-signal claude-code waiting",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${YOGO_REPO:-$HOME/Yogo}\"/bin/yogo-signal claude-code done",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${YOGO_REPO:-$HOME/Yogo}\"/bin/yogo-signal claude-code error",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${YOGO_REPO:-$HOME/Yogo}\"/bin/yogo-signal claude-code idle",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ]
  }
}
