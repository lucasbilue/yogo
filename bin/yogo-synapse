#!/bin/sh
# Mirror Synapse work-item status onto the Yogo display (read-only sidecar).
#   yogo-synapse --dump     see what it would show, change nothing
#   yogo-synapse -v         run it (Ctrl-C to stop)
DIR=$(cd "$(dirname "$0")/.." && pwd)
PY="$DIR/.venv/bin/python"; [ -x "$PY" ] || PY=python3
exec "$PY" "$DIR/adapters/synapse/yogo_synapse.py" "$@"
